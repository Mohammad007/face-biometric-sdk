# ── DapperDev Biometric SDK — Environment variables ─────────────────
# Copy to Railway → Variables. Do NOT commit a real .env file.

# Server (Railway sets PORT automatically — leave unset there)
HOST=0.0.0.0
PORT=8000

# Database. Local dev uses a file in the project folder.
# On Railway, attach a Volume and set this to the mount path,
# e.g. /app/data/biometric_data.db, so data survives redeploys.
DATABASE_PATH=biometric_data.db

# JWT — CHANGE THIS to a long random secret in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Super Admin bootstrap credentials — CHANGE THESE
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=admin12345

# Face engine tuning
FACE_MATCH_THRESHOLD=0.65
